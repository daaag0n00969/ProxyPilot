<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ProxyPilot</RootNamespace>
    <AssemblyName>ProxyPilot</AssemblyName>
    <Version>1.0.0</Version>
    <Product>ProxyPilot</Product>
    <Description>Transparent per-process SOCKS/HTTP proxy client for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProxyPilot.Core\ProxyPilot.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\third_party\WinDivert\WinDivert.dll" Link="WinDivert.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\third_party\WinDivert\WinDivert64.sys" Link="WinDivert64.sys">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\third_party\WinDivert\LICENSE.txt" Link="WinDivert-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
